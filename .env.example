# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/mayumy-chang
PORT=8110
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (dominio de producción, túneles), separados por coma
CORS_ORIGINS=
# Se usa en los enlaces de los correos
FRONTEND_URL=http://localhost:5277

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@mayumychang.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mayumy Chang <onboarding@resend.dev>

# Correo del equipo que recibe el aviso de pedidos y de leads (lista de espera, diseño a medida)
ORDERS_NOTIFY_EMAIL=

# ─── Cloudinary (fotos que se suben desde el panel) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payphone (Cajita de Pagos) ───────────────────────────────────────
# Sin token, el pago con tarjeta responde 503 y no se crea la orden.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
